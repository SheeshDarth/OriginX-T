{
  "name": "origin-t-console",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint . && prettier --check src",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../api/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5",
    "@tanstack/react-router": "1",
    "openapi-fetch": "0.13",
    "react": "18",
    "react-dom": "18"
  },
  "devDependencies": {
    "@eslint/js": "9",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "16",
    "@types/react": "18",
    "@types/react-dom": "18",
    "@vitejs/plugin-react": "4",
    "autoprefixer": "^10.6.2",
    "eslint": "9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "5",
    "globals": "^17.13.0",
    "jsdom": "25",
    "msw": "2",
    "openapi-typescript": "7",
    "postcss": "^8.5.32",
    "prettier": "3",
    "tailwindcss": "3",
    "typescript": "5.6",
    "typescript-eslint": "8",
    "vite": "5",
    "vitest": "2"
  }
