  "info": {
    "description": "Read-only access to ORIGIN-T's reports (HANDBOOK \u00a77.7). Errors are RFC 7807 problem+json. Responses carry a weak ETag; send it as If-None-Match for a 304.",
    "title": "ORIGIN-T API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/bench/samples": {
      "get": {
        "operationId": "bench_samples_v1_bench_samples_get",
        "parameters": [
          {
            "in": "query",
            "name": "dataset",
            "required": true,
            "schema": {
              "enum": [
                "wikitext2",
                "tinystories"
              ],
              "title": "Dataset",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "type",
            "required": true,
            "schema": {
              "enum": [
                "synthetic",
                "recursive",
                "paraphrased",
                "benchmark_near",
                "human_control"
              ],
              "title": "Type",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "ratio",
            "required": true,
            "schema": {
              "maximum": 1,
              "minimum": 0,
              "title": "Ratio",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "seed",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Seed",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/BenchSample"
                  },
                  "title": "Response Bench Samples V1 Bench Samples Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {}
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {}
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Bench Samples",
        "tags": [
          "bench"
        ]
      }
    },
